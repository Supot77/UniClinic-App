-- ============================================================
-- Partial unique indexes
-- ============================================================

-- ผู้ใช้ 1 คน ไม่สามารถมี appointment ที่ยังไม่ cancel ซ้ำ slot เดิม
CREATE UNIQUE INDEX IF NOT EXISTS idx_appointments_user_slot_active
ON public.appointments (user_id, slot_id)
WHERE status <> 'cancelled';

-- ผู้ใช้ 1 คน มี active reminder ของยาตัวเดียวกันได้เพียง 1 รายการ
CREATE UNIQUE INDEX IF NOT EXISTS idx_medication_reminders_user_med_active
ON public.medication_reminders (user_id, medication_id)
WHERE status = 'active';
